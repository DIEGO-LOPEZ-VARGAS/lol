{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Proyecto Tickets (Angular + .NET)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/Migracion/iniciar-local.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "serverReadyAction": {
        "pattern": "Now listening on: (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
